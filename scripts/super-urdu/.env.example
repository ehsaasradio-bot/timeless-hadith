# Copy this file to `.env` in the same directory and fill in your keys.
# `.env` is gitignored — do NOT commit real keys.

# Required for 02-draft-urdu.js
OPENAI_API_KEY=sk-...

# Optional — defaults to gpt-4o-mini
# OPENAI_MODEL=gpt-4o-mini

# Optional — number of parallel OpenAI requests, default 4
# CONCURRENCY=4

# Optional — only draft the first N rows (for smoke testing)
# LIMIT=3

# Required for 03-apply-urdu.js
# Get from: Supabase dashboard → Project Settings → API → service_role
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Optional — defaults to the project URL hardcoded in scripts
# SUPABASE_URL=https://dwcsledifvnyrunxejzd.supabase.co
