# Copy to `.env` in this directory. The .env file is gitignored.
# Generate Consumer Key/Secret in WordPress admin:
#   WooCommerce → Settings → Advanced → REST API → Add key (Read/Write)

WC_URL=https://shop.timelesshadith.com
WC_KEY=ck_REPLACE_ME
WC_SECRET=cs_REPLACE_ME

# Optional — request timeout in ms (default 15000)
# WC_TIMEOUT_MS=15000
